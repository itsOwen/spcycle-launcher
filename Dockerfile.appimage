# builds the linux appimage on ubuntu 22.04 rather than on the host.
#
# two reasons. glibc symbols are versioned, so a binary linked against arch's
# glibc refuses to start on anything older, and 22.04 is old enough to cover the
# distros people actually run. and linuxdeploy wants a toolchain it recognises,
# which arch is not.
#
#     docker build -f Dockerfile.appimage -t spcycle-appimage .
#     docker run --rm -v "$PWD/out:/out" spcycle-appimage
#
# tools/build-appimage.sh does both for you.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_TERM_COLOR=always

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates file git pkg-config python3 \
      libwebkit2gtk-4.1-dev libappindicator3-dev librsvg2-dev patchelf \
      libssl-dev desktop-file-utils fuse3 libfuse2 xz-utils zstd \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@11

WORKDIR /src

# dependencies first, so a source edit does not refetch the world
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# appimagetool needs fuse, which a container usually cannot give it. extracting
# it up front lets it run unprivileged.
ENV APPIMAGE_EXTRACT_AND_RUN=1
ENV NO_STRIP=1

CMD ["bash", "-lc", "\
  set -euo pipefail; \
  [ -f src-tauri/resources/depot.blob ] || { echo 'depot.blob is missing. run tools/fetch-depot-blob.sh on the host first.' >&2; exit 1; }; \
  [ -f src-tauri/resources/dwmapi.dll ] || { echo 'dwmapi.dll is missing. run tools/build-client-patch.sh on the host first.' >&2; exit 1; }; \
  pnpm tauri build --bundles appimage; \
  mkdir -p /out; \
  find src-tauri/target/release/bundle/appimage -maxdepth 1 -name '*.AppImage*' -exec cp {} /out/ \\; ; \
  ls -la /out"]
