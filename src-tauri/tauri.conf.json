{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SPCycle Launcher",
  "mainBinaryName": "spcycle-launcher",
  "version": "0.1.3",
  "identifier": "cc.spcycle.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SPCycle Launcher",
        "width": 1100,
        "height": 680,
        "minWidth": 1100,
        "minHeight": 680,
        "maxWidth": 1100,
        "maxHeight": 680,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'none'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwQ0NERkU1QjRDQjlEQjgKUldTNG5jdTA1ZC9Na0xNdGdqTXpHOW0yaVhvRVpVU1YvU2RQR2s2SzljazJSam1rZjVqQXU1UFAK",
      "endpoints": [
        "https://github.com/itsOwen/spcycle-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "appimage",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/depot.blob": "depot.blob"
    }
  }
}
